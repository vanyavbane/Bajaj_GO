{
  "name": "bajaj-go",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/sync-admanager.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.engine.json --noEmit",
    "test": "npm run check:roadside && npm run check:biomes && npm run check:blocks && npm run check:branch && npm run check:vectors && npm run check:route && npm run check:seat && npm run check:carriage && npm run check:exit && npm run check:repair && npm run check:audio && npm run check:gearbox",
    "check:exit": "node --experimental-strip-types js/engine/exit.check.ts",
    "check:roadside": "node --experimental-strip-types js/engine/roadside.check.ts",
    "check:biomes": "node --experimental-strip-types js/engine/biomes.check.ts",
    "check:blocks": "node --experimental-strip-types js/engine/blocks.check.ts",
    "check:branch": "node --experimental-strip-types js/engine/branch.check.ts",
    "check:vectors": "node --experimental-strip-types js/engine/vectors.check.ts",
    "check:route": "node --experimental-strip-types js/engine/route.check.ts",
    "check:seat": "node --experimental-strip-types js/engine/seat.check.ts",
    "check:carriage": "node --experimental-strip-types js/engine/carriage.check.ts",
    "check:repair": "node --experimental-strip-types js/engine/repair.check.ts",
    "check:audio": "node --experimental-strip-types js/engine/audio.check.ts",
    "check:gearbox": "node --experimental-strip-types js/engine/gearbox.check.ts",
    "scene": "node scripts/scene.mjs"
  },
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@bajajgo/design": "1.0.0",
    "@shoelace-style/shoelace": "^2.20.1",
    "three": "0.160.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.1.0"
  }
}
