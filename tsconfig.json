{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "noImplicitAny": false,
    "allowImportingTsExtensions": true,
    "types": []
  },
  "include": ["js/**/*.js", "js/**/*.d.ts", "js/**/*.ts", "vite.config.js"],
  "exclude": ["js/**/*.check.ts"]
}
